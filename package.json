{
  "name": "jntua-attendance",
  "main": "expo/AppEntry.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "eas:init": "eas-cli init",
    "build:preview": "eas-cli build --profile preview --platform android",
    "build:production": "eas-cli build --profile production --platform android",
    "update:staging": "eas-cli update --channel staging --message \"Staging update\"",
    "update:production": "eas-cli update --channel production --message \"Production update\"",
    "promote:production": "eas-cli promote --channel staging --to production"
  },
  "dependencies": {
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.35",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-updates": "~29.0.19",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0"
  },
  "private": true,
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}